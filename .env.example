# Supabase (projeto erp-emt, regiao sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role: SOMENTE no servidor (convites de usuario, operacoes admin e
# TODO o acesso ao bucket de anexos: upload, URL assinada e faxina).
# Sem ela, anexo nao sobe nem abre. Nunca exponha com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica do app (links de convite e redirects de auth).
# Em producao, use a URL do deploy na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do cron da Vercel que roda a faxina de arquivos orfaos
# (/api/faxina-arquivos, diario as 6h, ver vercel.json). A Vercel manda este
# valor como "Authorization: Bearer <CRON_SECRET>" nas chamadas do cron.
# Sem ela a rota responde 503 e o binario orfao so acumula no bucket.
# Gere um valor forte: openssl rand -base64 32
CRON_SECRET=

# Limite de tamanho por anexo, em MB. Opcional: o padrao e 25.
ANEXO_TAMANHO_MAXIMO_MB=25
